# Home Assistant 配置示例
# 
# ============================================
# 在 configuration.yaml 中添加以下配置：
#
# # 包含所有 input_number 配置
# input_number: !include_dir_merge_named inputs/
#
# # 包含所有 automation 配置
# automation: !include_dir_list automations/
#
# # 包含所有 script 配置
# script: !include_dir_list scripts/
#
# # 包含所有 rest_command 配置
# rest_command: !include_dir_merge_named rest_commands/
#
# # 包含所有 template 配置（按类型拆分）
# # templates/ 目录下按类型拆分文件：
# #   - templates/binary_sensor.yaml  # 所有 binary_sensor 类型
# #   - templates/sensor.yaml          # 所有 sensor 类型
# #   - templates/switch.yaml          # 所有 switch 类型（如有）
# #   - templates/light.yaml           # 所有 light 类型（如有）
# # 等等...
# template: !include_dir_merge_list templates/
#
# # 婴儿护理：input_select / input_button / input_datetime 等（与 inputs/ 中仅 input_number 并存）
# homeassistant:
#   packages:
#     baby_feeding: !include packages/baby_feeding.yaml
#
# ============================================
# 注意事项：
# - secrets.yaml 文件用于存储敏感信息（如 API token）
# - 请确保 secrets.yaml 文件已创建并配置了 serverchan_token
# - 建议将 secrets.yaml 添加到 .gitignore 以避免泄露敏感信息
#
