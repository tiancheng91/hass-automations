# Home Assistant 密钥配置文件
# 此文件包含敏感信息，请勿提交到版本控制系统
# 建议将 secrets.yaml 添加到 .gitignore

# Server酱 API Token
serverchan_token: YOUR_SERVERCHAN_TOKEN_HERE

# Claw OpenClaw API Bearer Token（不含 "Bearer " 前缀）
claw_token: CLAW_TOKEN


# Grafana Cloud Prometheus Basic Auth
grafana_prometheus_user: "635745"
grafana_prometheus_token: "REPLACE_WITH_METRICS_READ_TOKEN"
